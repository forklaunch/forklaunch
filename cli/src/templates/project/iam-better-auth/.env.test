DATABASE_TYPE={{database}}
MIGRATIONS_PATH=../migrations-{{database}}
BETTER_AUTH_SECRET=test-better-auth-secret-key-for-testing
CORS_ORIGINS=http://localhost:3000

# OAuth Providers (optional - uncomment and configure for OAuth)
# GOOGLE_CLIENT_ID=your-google-client-id-here
# GOOGLE_CLIENT_SECRET=your-google-client-secret-here

# Field encryption (test-only value)
ENCRYPTION_KEY=test-encryption-key-not-a-real-secret

# Test databases are local containers without TLS; production keeps verified TLS.
DB_SSL=false
