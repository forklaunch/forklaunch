DATABASE_URL=postgres://restricted_app:CHANGE_ME@localhost/app
TENANT_ID=11111111-1111-4111-8111-111111111111
WORKER_QUEUE={{{name}}}
RUST_LOG=info
WORKER_MAX_ATTEMPTS=3
WORKER_BACKOFF_SECONDS=30
WORKER_POLL_MS=250
WORKER_LEASE_MS=30000
WORKER_RENEW_MS=10000
WORKER_DRAIN_MS=30000
WORKER_CONCURRENCY=1
WORKER_BATCH_SIZE=1
# Automatic retention is disabled unless an age is explicitly configured;
# enabled retention requires the interval, batch limit and timeout below.
# WORKER_COMPLETED_RETENTION_SECONDS=604800
# WORKER_FAILED_RETENTION_SECONDS=2592000
WORKER_RETENTION_INTERVAL_MS=60000
WORKER_RETENTION_BATCH_LIMIT=100
WORKER_RETENTION_TIMEOUT_MS=5000

# Optional health/readiness listener; controls require a 32+ character secret.
# WORKER_HTTP_ADDR=127.0.0.1:8081
# WORKER_CONTROL_TOKEN=<generate-a-random-secret-of-at-least-32-characters>

# Optional group controls, scoped by namespace + TENANT_ID + WORKER_QUEUE.
# Configure both on every worker and administrative command.
# WORKER_SIGNAL_REDIS_URL=redis://localhost:6379/
# WORKER_SIGNAL_NAMESPACE=your-application-production

# Optional OTLP/HTTP export. Omit endpoints for local structured logs only.
# OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4318
# OTEL_EXPORTER_OTLP_PROTOCOL=http/protobuf
# OTEL_EXPORTER_OTLP_HEADERS=authorization=Bearer%20replace-me
# OTEL_SERVICE_NAME=replace-with-service-name
# OTEL_RESOURCE_ATTRIBUTES=deployment.environment.name=local
# OTEL_SDK_DISABLED=true

# Required for processing/enqueue. Use an independently generated 32-byte key.
# TENANT_ID must be a non-nil UUID from trusted deployment configuration.
ENCRYPTION_KEY_HEX=
ENCRYPTION_KEY_ID=primary
ENCRYPTION_PREVIOUS_KEYS_JSON={}
ENCRYPTION_LEGACY_KEY_HEX=disabled

# Only set true for isolated local Docker brokers without TLS.
WORKER_ALLOW_PLAINTEXT_DEVELOPMENT=false
