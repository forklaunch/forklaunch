# Required at startup; a missing value stops the process with its name.
RUST_LOG=info
PROTOCOL=http
HOST=127.0.0.1
PORT=8080
VERSION=v1
DOCS_PATH=/docs
MCP_ENABLED=true
# Optional: without them the service documents its own listener address.
DOCS_SERVER_URLS=http://127.0.0.1:8080
DOCS_SERVER_DESCRIPTIONS=Main Server

# Optional OTLP/HTTP export. Omit endpoints for local structured logs only.
# OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4318
# OTEL_EXPORTER_OTLP_PROTOCOL=http/protobuf
# OTEL_EXPORTER_OTLP_HEADERS=authorization=Bearer%20replace-me
# OTEL_SERVICE_NAME=replace-with-service-name
# OTEL_RESOURCE_ATTRIBUTES=deployment.environment.name=local
# OTEL_SDK_DISABLED=true
