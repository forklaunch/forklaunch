{
  "name": "@forklaunch/interfaces-worker",
  "version": "1.0.31",
  "description": "Worker interfaces for forklaunch",
  "homepage": "https://github.com/forklaunch/forklaunch-js#readme",
  "bugs": {
    "url": "https://github.com/forklaunch/forklaunch-js/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/forklaunch/forklaunch-js.git"
  },
  "license": "MIT",
  "author": "Forklift Technologies, Inc.",
  "exports": {
    "./interfaces": {
      "types": "./lib/interfaces/index.d.ts",
      "import": "./lib/interfaces/index.mjs",
      "require": "./lib/interfaces/index.js",
      "default": "./lib/interfaces/index.js"
    },
    "./types": {
      "types": "./lib/types/index.d.ts",
      "import": "./lib/types/index.mjs",
      "require": "./lib/types/index.js",
      "default": "./lib/types/index.js"
    },
    "./interfaces/*": {
      "types": "./lib/interfaces/*.d.ts"
    },
    "./types/*": {
      "types": "./lib/types/*.d.ts"
    }
  },
  "files": [
    "lib/**"
  ],
  "scripts": {
    "build": "tsc --noEmit && tsup interfaces/index.ts types/index.ts --format cjs,esm --no-splitting --tsconfig tsconfig.json --out-dir lib --clean && tsc -p tsconfig.build.json --emitDeclarationOnly && if [ -f eject-package.bash ]; then pnpm package:eject; fi",
    "clean": "rm -rf lib tsconfig.tsbuildinfo pnpm.lock.yaml node_modules",
    "docs": "typedoc --out docs *",
    "format": "prettier --ignore-path=.prettierignore --config .prettierrc '**/*.{ts,tsx,json}' --write",
    "lint": "eslint . -c eslint.config.mjs",
    "lint:fix": "eslint . -c eslint.config.mjs --fix",
    "package:eject": "./eject-package.bash",
    "prepack": "pnpm run build",
    "publish:package": "./publish-package.bash",
    "test": "vitest --passWithNoTests"
  },
  "devDependencies": {
    "depcheck": "^1.4.7",
    "eslint": "^10.9.1",
    "prettier": "^3.9.6",
    "typedoc": "^0.28.20",
    "typescript": "^7.0.2",
    "typescript-eslint": "^8.68.0"
  },
  "publishConfig": {
    "access": "public"
  }
}
