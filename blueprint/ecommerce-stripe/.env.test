# Test environment variables for ecommerce-stripe.
# Loaded during test execution. Mirrors billing-stripe/.env.test.
#
# Every value here is a non-functional placeholder. Nothing in this file is a
# real credential and none of it reaches a live provider: the purchase-loop
# test drives the module's own HTTP handlers against a testcontainers
# Postgres/Redis, and does not call Stripe or PayPal. If a test is ever added
# that genuinely exercises a provider, it must read a real key from the
# environment (see billing-stripe's getEnvVar('STRIPE_API_KEY') pattern) rather
# than relying on these.

# Database — tests use testcontainers, this only selects the driver
DATABASE_TYPE=postgresql

# Required by mikro-orm.config.ts's FieldEncryptor. Any non-empty string works:
# FieldEncryptor treats it as HKDF-SHA256 input key material, not a raw key.
ENCRYPTION_KEY=test-encryption-key-not-a-real-secret

# Signs the /catalog-import endpoint. The test overrides this with its own
# value via customEnvVars so it can produce matching signatures.
HMAC_SECRET_KEY=test-hmac-secret-not-a-real-secret

# Stripe — placeholders. The Stripe SDK rejects an empty string at construction
# time, which is why these cannot simply be left blank.
STRIPE_API_KEY=sk_test_placeholder_not_a_real_key
STRIPE_WEBHOOK_SECRET=whsec_test_placeholder_not_a_real_secret

# PayPal — placeholders, same reasoning.
PAYPAL_CLIENT_ID=test-paypal-client-id
PAYPAL_CLIENT_SECRET=test-paypal-client-secret
PAYPAL_BASE_URL=https://api-m.sandbox.paypal.com
PAYPAL_WEBHOOK_ID=test-paypal-webhook-id

# Order-event queue. The harness supplies a container-backed REDIS_URL; this is
# the fallback for a locally running Redis.
REDIS_URL=redis://localhost:6379
ORDER_EVENT_QUEUE=test-order-events
