{
  "name": "@forklaunch/implementation-cac-base",
  "version": "0.2.4",
  "description": "Computer-assisted coding basic implementation for forklaunch",
  "homepage": "https://github.com/forklaunch/forklaunch-js#readme",
  "bugs": {
    "url": "https://github.com/forklaunch/forklaunch-js/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/forklaunch/forklaunch-js.git"
  },
  "license": "MIT",
  "author": "Forklift Technologies, Inc.",
  "exports": {
    "./services": {
      "types": "./lib/services/index.d.ts",
      "import": "./lib/index.mjs",
      "require": "./lib/index.js",
      "default": "./lib/index.js"
    },
    "./services/*": {
      "types": "./lib/services/*.d.ts"
    }
  },
  "files": [
    "lib/**"
  ],
  "scripts": {
    "build": "tsc --noEmit && tsup services/index.ts --format cjs,esm --no-splitting --tsconfig tsconfig.json --out-dir lib --clean && tsc -p tsconfig.build.json --emitDeclarationOnly && if [ -f eject-package.bash ]; then pnpm package:eject; fi",
    "clean": "rm -rf lib pnpm.lock.yaml node_modules",
    "docs": "typedoc --out docs *",
    "format": "prettier --ignore-path=.prettierignore --config .prettierrc '**/*.{ts,tsx,json}' --write",
    "lint": "eslint . -c eslint.config.mjs",
    "lint:fix": "eslint . -c eslint.config.mjs --fix",
    "package:eject": "./eject-package.bash",
    "prepack": "pnpm run build",
    "publish:package": "./publish-package.bash",
    "test": "vitest --passWithNoTests"
  },
  "dependencies": {
    "@forklaunch/common": "^1.2.27",
    "@forklaunch/core": "^1.6.5",
    "@forklaunch/interfaces-cac": "workspace:^",
    "@forklaunch/internal": "^1.2.30",
    "@forklaunch/validator": "^1.2.28",
    "@mikro-orm/core": "7.2.1"
  },
  "devDependencies": {
    "depcheck": "^1.4.7",
    "prettier": "^3.9.8",
    "typedoc": "^0.28.20",
    "typescript": "^7.0.2"
  },
  "publishConfig": {
    "access": "public"
  }
}
