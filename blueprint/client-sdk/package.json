{
  "name": "@forklaunch/blueprint-client-sdk",
  "version": "0.1.0",
  "private": true,
  "description": "The forklaunch client SDK to be used anywhere",
  "keywords": [],
  "license": "MIT",
  "author": "Rohin Bhargava",
  "scripts": {
    "build": "tsc -b",
    "clean": "rm -rf dist tsconfig.tsbuildinfo pnpm.lock.yaml node_modules",
    "docs": "typedoc --out docs *",
    "format": "prettier --ignore-path=.prettierignore --config .prettierrc '**/*.{ts,tsx,json}' --write",
    "lint": "eslint . -c eslint.config.mjs",
    "lint:fix": "eslint . -c eslint.config.mjs --fix",
    "prepack": "pnpm run build",
    "test": "pnpm vitest --passWithNoTests"
  },
  "dependencies": {
    "@forklaunch/common": "^1.2.26",
    "@forklaunch/universal-sdk": "^1.2.27",
    "better-auth": "^1.7.2"
  },
  "devDependencies": {
    "@forklaunch/blueprint-billing-base": "workspace:^",
    "@forklaunch/blueprint-billing-stripe": "workspace:^",
    "@forklaunch/blueprint-core": "workspace:^",
    "@forklaunch/blueprint-iam-base": "workspace:^",
    "@forklaunch/blueprint-iam-better-auth": "workspace:^",
    "@forklaunch/blueprint-sample-worker": "workspace:^",
    "@forklaunch/core": "^1.5.19",
    "typescript": "^7.0.2"
  }
}
