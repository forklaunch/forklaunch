# Test environment variables for messaging-twilio
# These variables are loaded during test execution

# Database configuration (optional - tests use testcontainers by default)
DATABASE_TYPE=postgres

# Twilio configuration (provided by customEnvVars in test setup)
TWILIO_ACCOUNT_SID=ACtest1234567890abcdef1234567890ab
TWILIO_AUTH_TOKEN=test_auth_token_1234567890abcdef
TWILIO_FROM_NUMBER=+15005550006
