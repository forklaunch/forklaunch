{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "options": {
    "typeAware": true
  },
  "categories": {
    "correctness": "error",
    "suspicious": "warn",
    "perf": "warn",
    "style": "off",
    "pedantic": "off"
  },
  "ignorePatterns": [
    "**/tests/**/*",
    "**/dist/**/*",
    "**/lib/**/*",
    "**/node_modules/**/*",
    "**/sdk/typescript/**/*",
    "**/events/typescript/**/*"
  ],
  "overrides": [
    {
      "files": ["**/*.ts", "**/*.tsx"],
      "rules": {
        "no-async-endpoint-handlers": "off",
        "no-await-in-loop": "off",
        "unicorn/require-module-specifiers": "off",
        "typescript/no-unnecessary-type-assertion": "off"
      }
    }
  ]
}
