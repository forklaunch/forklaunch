[package]
edition = "2021"
rust-version = "1.85.0"
name = "jsonschema"
version = "0.58.6"
authors = ["Dmitry Dygalo <dmitry@dygalo.dev>"]
build = false
autolib = false
autobins = false
autoexamples = false
autotests = false
autobenches = false
description = "JSON schema validaton library"
readme = "README.md"
keywords = [
    "jsonschema",
    "validation",
]
categories = ["web-programming"]
license = "MIT"
repository = "https://github.com/Stranger6667/jsonschema"
resolver = "3"

[package.metadata.docs.rs]
all-features = true

[features]
arbitrary-precision = [
    "serde_json/arbitrary_precision",
    "dep:num-bigint",
    "jsonschema-macros?/arbitrary-precision",
    "jsonschema-value/arbitrary-precision",
]
conformance = ["jsonschema-value/conformance"]
default = [
    "resolve-http",
    "resolve-file",
    "tls-aws-lc-rs",
    "idna",
]
idna = ["dep:idna"]
jsonb = ["jsonschema-value/jsonb"]
macros = [
    "dep:jsonschema-macros",
    "jsonschema-macros/float-roundtrip",
    "jsonschema-value/macros",
]
magnus = [
    "jsonschema-value/magnus",
    "dep:magnus",
]
pyo3 = [
    "jsonschema-value/pyo3",
    "dep:pyo3",
]
resolve-async = [
    "referencing/retrieve-async",
    "reqwest",
    "dep:async-trait",
    "dep:tokio",
]
resolve-file = []
resolve-http = [
    "reqwest",
    "dep:rustls",
]
tls-aws-lc-rs = ["rustls/aws-lc-rs"]
tls-ring = ["rustls/ring"]

[lib]
name = "jsonschema"
path = "src/lib.rs"

[[test]]
name = "annotation_suite"
path = "tests/annotation_suite.rs"

[[test]]
name = "bundle"
path = "tests/bundle.rs"

[[test]]
name = "canonical_proptest"
path = "tests/canonical_proptest.rs"

[[test]]
name = "canonical_suite"
path = "tests/canonical_suite.rs"

[[test]]
name = "canonicalization"
path = "tests/canonicalization.rs"

[[test]]
name = "codegen"
path = "tests/codegen.rs"
required-features = ["macros"]

[[test]]
name = "custom_representation"
path = "tests/custom_representation.rs"

[[test]]
name = "dereference"
path = "tests/dereference.rs"

[[test]]
name = "jsonb"
path = "tests/jsonb.rs"

[[test]]
name = "lazy_instance"
path = "tests/lazy_instance.rs"

[[test]]
name = "leak"
path = "tests/leak.rs"

[[test]]
name = "output_suite"
path = "tests/output_suite.rs"

[[test]]
name = "ref_chain"
path = "tests/ref_chain.rs"

[[test]]
name = "suite"
path = "tests/suite.rs"
required-features = ["macros"]

[[test]]
name = "wasm"
path = "tests/wasm.rs"

[[test]]
name = "wasm_wasi"
path = "tests/wasm_wasi.rs"

[[bench]]
name = "canonicalize"
path = "benches/canonicalize.rs"
harness = false
required-features = ["macros"]

[[bench]]
name = "canonicalize_many"
path = "benches/canonicalize_many.rs"
harness = false
required-features = ["macros"]

[[bench]]
name = "codegen"
path = "benches/codegen.rs"
harness = false
required-features = ["macros"]

[[bench]]
name = "errors"
path = "benches/errors.rs"
harness = false

[[bench]]
name = "jsonb"
path = "benches/jsonb.rs"
harness = false
required-features = ["jsonb"]

[[bench]]
name = "jsonschema"
path = "benches/jsonschema.rs"
harness = false
required-features = ["macros"]

[[bench]]
name = "keywords"
path = "benches/keywords.rs"
harness = false

[[bench]]
name = "location"
path = "benches/location.rs"
harness = false

[[bench]]
name = "metaschema"
path = "benches/metaschema.rs"
harness = false
required-features = ["macros"]

[[bench]]
name = "unevaluated_items"
path = "benches/unevaluated_items.rs"
harness = false

[[bench]]
name = "unevaluated_properties"
path = "benches/unevaluated_properties.rs"
harness = false

[dependencies.ahash]
version = "0.8"
features = ["serde"]

[dependencies.async-trait]
version = "0.1.86"
optional = true

[dependencies.bytecount]
version = "0.6"
features = ["runtime-dispatch-simd"]

[dependencies.data-encoding]
version = "2.9"

[dependencies.email_address]
version = "0.2.9"

[dependencies.fancy-regex]
version = "0.19"

[dependencies.fraction]
version = "0.17"
features = ["with-bigint"]
default-features = false

[dependencies.idna]
version = "1.0.2"
optional = true

[dependencies.itoa]
version = "1"

[dependencies.jsonschema-macros]
version = "0.58.6"
optional = true

[dependencies.jsonschema-regex]
version = "0.58.6"

[dependencies.jsonschema-value]
version = "0.58.6"

[dependencies.magnus]
version = "0.9"
features = ["rb-sys"]
optional = true

[dependencies.num-bigint]
version = "0.4"
optional = true

[dependencies.num-cmp]
version = "0.1"

[dependencies.num-traits]
version = "0.2.19"

[dependencies.percent-encoding]
version = "2.3"

[dependencies.pyo3]
version = "0.29"
optional = true

[dependencies.referencing]
version = "0.58.6"

[dependencies.regex]
version = "1.11.1"

[dependencies.serde]
version = "1.0"
features = ["derive"]

[dependencies.serde_json]
version = "1"
features = ["float_roundtrip"]

[dependencies.strum]
version = "0.28.0"
features = ["derive"]

[dependencies.tokio]
version = "1"
features = ["rt"]
optional = true
default-features = false

[dependencies.unicode-general-category]
version = "1.1"

[dependencies.uuid-simd]
version = "0.8"
features = [
    "std",
    "detect",
]
default-features = false

[dev-dependencies.futures]
version = "0.3"
features = ["std"]
default-features = false

[dev-dependencies.test-case]
version = "3"

[target.'cfg(all(target_arch = "wasm32", any(target_os = "unknown", target_os = "none")))'.dependencies.reqwest]
version = "0.13"
features = ["json"]
optional = true
default-features = false

[target.'cfg(all(target_arch = "wasm32", target_os = "unknown"))'.dev-dependencies.wasm-bindgen-test]
version = "0.3.55"

[target.'cfg(not(target_arch = "wasm32"))'.dependencies.reqwest]
version = "0.13"
features = [
    "blocking",
    "json",
    "http2",
    "rustls-no-provider",
]
optional = true
default-features = false

[target.'cfg(not(target_arch = "wasm32"))'.dependencies.rustls]
version = "0.23"
features = [
    "std",
    "tls12",
]
optional = true
default-features = false

[target.'cfg(not(target_arch = "wasm32"))'.dev-dependencies.codspeed-criterion-compat]
version = "5.0"
default-features = false

[target.'cfg(not(target_arch = "wasm32"))'.dev-dependencies.criterion]
version = "0.8"
default-features = false

[target.'cfg(not(target_arch = "wasm32"))'.dev-dependencies.hegeltest]
version = "0.48"
features = ["serde_json"]

[target.'cfg(not(target_arch = "wasm32"))'.dev-dependencies.tempfile]
version = "3.13.0"

[target.'cfg(not(target_arch = "wasm32"))'.dev-dependencies.test-case]
version = "3"

[target.'cfg(not(target_arch = "wasm32"))'.dev-dependencies.tokio]
version = "1"
features = [
    "macros",
    "rt",
]

[target.'cfg(target_arch = "wasm32")'.dependencies.getrandom]
version = "0.3.4"
features = ["wasm_js"]

[lints.clippy]
dbg_macro = "warn"
empty_drop = "warn"
empty_structs_with_brackets = "warn"
exit = "warn"
get_unwrap = "warn"
module_name_repetitions = "allow"
print_stderr = "warn"
print_stdout = "warn"
rc_buffer = "warn"
rc_mutex = "warn"
rest_pat_in_fully_bound_structs = "warn"
similar_names = "allow"
too_many_arguments = "allow"
too_many_lines = "allow"

[lints.clippy.pedantic]
level = "warn"
priority = -2

[lints.rust]
unreachable_pub = "warn"
unsafe_code = "warn"
