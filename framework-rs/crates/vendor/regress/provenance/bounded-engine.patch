+// ECMAScript non-Unicode Canonicalize works over code units and does not fold
+// non-ASCII characters into ASCII. Build sorted runs without quadratic inserts.
+pub(crate) fn add_legacy_icase_code_points(input: CodePointSet) -> CodePointSet {
+    if !crate::compile_ledger::charge(
+        65536,
+        131073usize.saturating_mul(input.intervals().len().saturating_add(1)),
+    ) {
+        return CodePointSet::default();
+    }
+    let mut canonical = vec![false; 65536];
+    for cp in 0..=65535 {
+        if input.contains(cp) {
+            canonical[fold_code_point(cp, false) as usize] = true;
+        }
+    }
+    let mut ranges = Vec::new();
+    let mut start = None;
+    for cp in 0..=65536 {
+        let yes = cp < 65536 && canonical[fold_code_point(cp, false) as usize];
+        match (start, yes) {
+            (None, true) => start = Some(cp),
+            (Some(first), false) => {
+                if !crate::compile_ledger::reserve(&mut ranges, 1) {
+                    return CodePointSet::default();
+                }
+                ranges.push(Interval {
+                    first,
+                    last: cp - 1,
+                });
+                start = None;
+            }
+            _ => {}
+        }
+    }
+    CodePointSet::from_sorted_disjoint_intervals(ranges)
+}
