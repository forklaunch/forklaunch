+#[cfg(feature = "utf16")]
+pub(crate) fn test_limited<Input: InputIndexer>(
+    re: &CompiledRegex,
+    input: Input,
+    input_units: usize,
+    sticky: bool,
+    limits: crate::limits::MatchLimits,
+) -> Result<bool, crate::limits::ResourceLimit> {
+    use crate::limits::{MatchBudget, ResourceLimit};
+    if input_units > limits.input_units {
+        return Err(ResourceLimit::Input);
+    }
+    let cost = input_units
+        .checked_add(re.groups as usize)
+        .and_then(|n| n.checked_add(4))
+        .ok_or(ResourceLimit::Work)?;
+    let state_bytes = (re.groups as usize)
+        .checked_mul(core::mem::size_of::<GroupData<Input::Position>>())
+        .and_then(|n| {
+            n.checked_add(
+                (re.loops as usize)
+                    .checked_mul(core::mem::size_of::<LoopData<Input::Position>>())?,
+            )
+        })
+        .ok_or(ResourceLimit::Stack)?;
+    if state_bytes
+        .checked_add(core::mem::size_of::<BacktrackInsn<Input>>())
+        .ok_or(ResourceLimit::Stack)?
+        > limits.stack_bytes
+    {
+        return Err(ResourceLimit::Stack);
+    }
+    let mut matcher = MatchAttempter::new(re, input.left_end());
+    matcher.budget = Some(MatchBudget {
+        remaining: limits.work,
+        stack_bytes: limits.stack_bytes,
+        depth_limit: limits.lookaround_depth.min(128),
+        depth: 0,
+        parent_bytes: state_bytes,
+        cost,
+        exhausted: None,
+    });
+    let mut pos = input.left_end();
+    loop {
+        if !matcher.admit_instruction() {
+            return Err(matcher.budget.as_ref().unwrap().exhausted.unwrap());
+        }
+        let found = matcher.try_at_pos(input, 0, pos, Forward::new()).is_some();
+        if let Some(error) = matcher.budget.as_ref().unwrap().exhausted {
+            return Err(error);
+        }
+        if found {
+            return Ok(true);
+        }
+        if sticky {
+            return Ok(false);
+        }
+        match input.next_right_pos(pos) {
+            Some(next) => pos = next,
+            None => return Ok(false),
+        }
+    }
+}
