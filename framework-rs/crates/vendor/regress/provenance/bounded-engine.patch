+#[cfg(feature = "utf16")]
+impl Regex {
+    /// Scratch limited compiler. Admission is conservative and may reject a
+    /// valid expression explicitly; it never reports resource exhaustion as a
+    /// syntax error or nonmatch. The optimizer is deliberately disabled.
+    #[cfg(feature = "std")]
+    pub fn from_utf16_limited(
+        pattern: &[u16],
+        mut flags: Flags,
+        limits: crate::limits::CompileLimits,
+    ) -> Result<Self, crate::limits::CompileFailure> {
+        flags.unicode |= flags.unicode_sets;
+        let ledger = crate::compile_ledger::Scope::enter(limits);
+        crate::limits::admit_compile(pattern, flags, limits)?;
+        flags.no_opt = true;
+        let mut codes = Vec::new();
+        if !crate::compile_ledger::reserve(&mut codes, pattern.len()) {
+            ledger.outcome()?;
+        }
+        if flags.unicode {
+            codes.extend(
+                char::decode_utf16(pattern.iter().copied()).map(|c| match c {
+                    Ok(c) => u32::from(c),
+                    Err(e) => u32::from(e.unpaired_surrogate()),
+                }),
+            );
+        } else {
+            codes.extend(pattern.iter().copied().map(u32::from));
+        }
+        let parsed = parse::try_parse(codes.iter().copied(), flags);
+        ledger.outcome()?;
+        let ir = parsed.map_err(crate::limits::CompileFailure::Syntax)?;
+        let remaining = ledger.remaining(limits);
+        let plan = crate::limits::admit_ir(&ir.node, remaining)?;
+        let cr = emit::emit_limited(&ir, plan, remaining.allocation_units)?;
+        ledger.outcome()?;
+        Ok(Self { cr })
+    }
+}
