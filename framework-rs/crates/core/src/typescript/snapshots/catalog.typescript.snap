                            // the native codec deliver it.
                            let parsed: unknown;
                            try {
                                parsed = JSON.parse(raw);
                            }
                            catch {
                                parsed = raw;
                            }
                            const event = id === undefined ? { data: parsed } : { data: parsed, id };
                            const decoded = validate ? validate(event) : event;
                            yield decoded as { data: unknown; id?: string };
                        }
