                        skipLf = false;
                        if (byte === 10)
                            continue;
                    }
                    if (++frameBytes > maxEventBytes)
                        throw new RangeError('SSE event exceeds configured limit');
                    if (byte !== 10 && byte !== 13) {
                        line.push(byte);
                        continue;
                    }
                    skipLf = byte === 13;
