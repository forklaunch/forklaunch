    let firstLine = true;
    let frameBytes = 0;
    let released = false;
    async function close() {
        if (released)
            return;
        released = true;
        try {
            onClose();
            await reader.cancel();
        }
        catch { /* Preserve the original read/parse error. */ }
        finally {
            reader.releaseLock();
        }
    }
