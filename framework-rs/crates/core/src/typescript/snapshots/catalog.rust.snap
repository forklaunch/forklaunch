            200 if _content_type == "text/event-stream" => {




                let body=Box::new(SdkEventStream::from_response(response,self.runtime.sse_event_limit(), "{\"additionalProperties\":false,\"properties\":{\"data\":{\"additionalProperties\":false,\"properties\":{\"id\":{\"minLength\":1,\"type\":\"string\"}},\"required\":[\"id\"],\"type\":\"object\"},\"id\":{\"type\":\"string\"}},\"required\":[\"data\"],\"type\":\"object\"}")?);


                Ok(NativeEventsResponses::Status200(body))
            },

            _ => Err(SdkError::Contract("undeclared response status or content type")),
        }
    }



