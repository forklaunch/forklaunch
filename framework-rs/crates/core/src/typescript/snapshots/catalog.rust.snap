            url: format!("{}{}", self.runtime.base_url(), path),
            query: input.query,
            headers: input.headers,
            body: None,
            body_bytes: None,

            multipart: None,
            content_type: "application/json",
        })
    }


    pub async fn delete_item(&self, input: DeleteItemRequest) -> Result<DeleteItemResponses, SdkError> {
        let request = self.delete_item_request(input).map_err(SdkError::Encode)?;

        let response = self.runtime.execute(request).await?;
        let status = response.status().as_u16();
        let _content_type = runtime::response_content_type(&response)?;

        match status {

            204 => {

                let bytes=response.bytes().await?; let _=bytes; let body=();





                Ok(DeleteItemResponses::Status204(body))
            },

            _ => Err(SdkError::Contract("undeclared response status or content type")),
        }
    }


